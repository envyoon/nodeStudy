<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>로그인</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <div class="wrap">
      <div class="card" role="region" aria-labelledby="login-title">
        <h1 id="login-title">로그인</h1>
        <p class="muted">아이디와 비밀번호로 로그인하거나, 카카오로 간편 로그인하세요.</p>

        <!-- 일반 로그인 입력 UI (폼 없음) -->
        <div id="login-box" class="form">
          <div class="field">
            <label for="login-id">아이디(또는 이메일)</label>
            <input id="login-id" type="text" placeholder="아이디 입력" autocomplete="username" />
          </div>
          <div class="field">
            <label for="login-pw">비밀번호</label>
            <input id="login-pw" type="password" placeholder="비밀번호 입력" autocomplete="current-password" />
          </div>

          <div id="login-error" class="muted" style="color: #d00; display: none"></div>

          <div class="actions">
            <button id="btn-login" class="btn btn-primary" type="button">로그인</button>
          </div>
        </div>

        <div class="row-center">계정이 없나요? <a href="/auth/signup">회원가입</a></div>

        <div class="divider">또는</div>

        <!-- 카카오 로그인 -->
        <button id="btn-kakao-login" class="btn-kakao" type="button" aria-label="카카오로 로그인">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M12 3C6.48 3 2 6.53 2 10.88c0 2.93 2.08 5.49 5.15 6.83l-.86 3.22a.7.7 0 0 0 1.03.8l3.8-2.22c.29.02.58.03.88.03 5.52 0 10-3.53 10-7.86C22 6.53 17.52 3 12 3z" fill="currentColor"></path>
          </svg>
          카카오로 로그인
        </button>
      </div>
    </div>

    <!-- 라이브러리 (로컬이면 integrity 제거) -->
    <script src="/lib/axios.min.js"></script>
    <script src="/lib/kakao.min.js" crossorigin="anonymous"></script>
    <script src="/javascripts/main.js"></script>
  </body>
</html>
