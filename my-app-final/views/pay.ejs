<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>결제</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <script src="<%= kcpJsUrl %>"></script>
    <script src="/javascripts/pay.js"></script>
  </head>
  <body>
    <div class="wrap">
      <div class="card pay-card" role="region" aria-labelledby="pay-title">
        <h1 id="pay-title">채팅 이용 결제</h1>
        <p class="muted"><%= who %> 님, 채팅을 사용하기 위해서는 결제가 필요합니다.</p>
        <% if (meta && meta.error) { %>
        <p class="muted" style="color: #d00"><%= meta.error %></p>
        <% } %>

        <div class="pay-actions" role="group" aria-label="결제 동작">
          <form onsubmit="return false">
            <button class="btn btn-primary" type="button" id="btn-kcp">결제하기</button>
          </form>
        </div>

        <!-- KCP 결제용 숨김 폼 (표준 웹) -->
        <form name="kcpForm" id="kcpForm" method="post" action="/pay/kcp/pay" style="display: none">
          <!-- 필수 기본 -->
          <input type="hidden" name="site_cd" value="<%= kcpSiteCd %>" />
          <input type="hidden" name="pay_method" value="100000000000" />
          <input type="hidden" name="quotaopt" value="12" />

          <!-- KCP가 채우는 필드 -->
          <input type="hidden" name="res_cd" value="" />
          <input type="hidden" name="res_msg" value="" />
          <input type="hidden" name="enc_info" value="" />
          <input type="hidden" name="enc_data" value="" />
          <input type="hidden" name="tran_cd" value="" />

          <!-- 주문/상품/금액/구매자 -->
          <input type="hidden" name="ordr_idxx" value="<%= order.id %>" />
          <input type="hidden" name="good_name" value="<%= order.name %>" />
          <input type="hidden" name="good_mny" value="<%= order.amount %>" />
          <input type="hidden" name="buyr_name" value="<%= buyer.name %>" />
          <input type="hidden" name="buyr_tel2" value="<%= buyer.tel %>" />
          <input type="hidden" name="buyr_mail" value="<%= buyer.email %>" />
        </form>

        <div class="row-center" style="margin-top: 16px">
          <a href="/pay/leave">돌아가기</a>
        </div>
      </div>
    </div>
  </body>
</html>
